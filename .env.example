# Public Supabase client configuration.
# Use the Project URL and publishable key only — never put the service_role key in Vite.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Legacy fallback if needed:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Optional: enables the full in-page Google Maps picker for individual customer addresses.
# Restrict this browser key in Google Cloud to your production domains and the Maps JavaScript API + Places API.
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
