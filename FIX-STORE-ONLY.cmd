@echo off
setlocal EnableExtensions
chcp 65001 >nul
cd /d "%~dp0"

if not exist "src\individual\IndividualPortalLayout.jsx" (
  echo [ERROR] Put FIX-STORE-ONLY.cmd inside the Balqees project root next to package.json, then double-click it.
  echo Nothing was changed.
  pause
  exit /b 1
)

powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 (
  echo.
  echo [STOPPED] Patch validation failed. Nothing outside the two target files was touched.
  pause
  exit /b 1
)

echo.
echo Done. The Store-only fix has been applied.
pause
